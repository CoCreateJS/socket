{
  "name": "@cocreate/socket",
  "version": "3.0.1",
  "description": "Client and server WebSocket interfaces for CoCreate.",
  "keywords": [
    "websocket-server",
    "real-time-collaboration",
    "multi-tenancy",
    "state-synchronization",
    "cluster-mesh",
    "headless-cms",
    "low-latency",
    "p2p-replication",
    "event-streaming"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "demo": "PORT=5000 node demo/server.js",
    "test": "node --test",
    "test:server": "node --test test/server/*.test.js",
    "test:client": "node --test test/client/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/socket.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/socket/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/socket",
  "dependencies": {
    "@cocreate/config": "^2.0.1",
    "@cocreate/utils": "^2.0.2",
    "@cocreate/organizations": "^3.0.1",
    "ws": "^8.21.1"
  },
  "exports": {
    ".": {
      "browser": "./src/client/index.js",
      "default": "./src/index.js"
    },
    "./server": "./src/server/index.js",
    "./client": "./src/client/index.js"
  },
  "browser": "./src/client/index.js"
}
